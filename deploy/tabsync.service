[Unit]
Description=Tab Sync backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tabsync
Group=tabsync
WorkingDirectory=/opt/tabsync/current/backend
Environment=PORT=3000
Environment=DATABASE_PATH=/var/lib/tabsync/tabsync.sqlite
ExecStart=/usr/local/bin/bun run start
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tabsync

[Install]
WantedBy=multi-user.target
